# All the app's settings. Copy this to .env.local to run locally, or set the same names in Amplify.

# API Gateway base URL, e.g. https://abc123.execute-api.ap-southeast-1.amazonaws.com/Prod
# Leave empty to run on mock data.
VITE_API_URL=

# true = keep using mock data even when VITE_API_URL is set
VITE_USE_MOCK=false

# How often the app re-fetches readings, in milliseconds (default 5 minutes)
VITE_REFRESH_MS=300000

# Link to the user-testing questionnaire; shows a "Give feedback" link in the sidebar when set
VITE_FEEDBACK_URL=

# PLACEHOLDER — Auth & Settings: Cognito settings (suggested names; rename if you prefer and update this file)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-southeast-1

# PLACEHOLDER — Notifications: public VAPID key for Web Push (suggested name)
VITE_VAPID_PUBLIC_KEY=
