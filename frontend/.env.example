# All the app's settings. Copy this to .env.local to run locally, or set the same names in Amplify.

# API Gateway base URL, e.g. https://abc123.execute-api.ap-southeast-1.amazonaws.com/Prod
# Leave empty to run on mock data.
VITE_API_URL=

# Address of the profile API (GET and PUT /api/me) while it has its own URL, e.g. http://localhost:8000
# when running backend/profile on your own computer. Leave empty to use VITE_API_URL.
VITE_PROFILE_API_URL=
VITE_ALERTS_API_URL=https://2drzz454bj.execute-api.ap-southeast-1.amazonaws.com/Prod

# true = keep using mock data even when VITE_API_URL is set
VITE_USE_MOCK=false

# How often the app re-fetches readings, in milliseconds (default 5 minutes)
VITE_REFRESH_MS=300000

# Link to the user-testing questionnaire; shows a "Give feedback" link in the sidebar when set
VITE_FEEDBACK_URL=https://docs.google.com/forms/d/e/1FAIpQLSdwk5LkyeA732MGVQdkNABW_3qJbhXRu72iIeq949UspVWHOg/viewform

# Auth & Settings: Cognito user pool for login. These IDs are not secrets (they are visible in the website's code).
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_AgBeTCbeW
VITE_COGNITO_CLIENT_ID=403f0r15ekgm1n6ihqiu007eim
VITE_COGNITO_REGION=ap-southeast-1

# PLACEHOLDER — Notifications: public VAPID key for Web Push (suggested name)
VITE_VAPID_PUBLIC_KEY=